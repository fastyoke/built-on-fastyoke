{
  "name": "built-on-fastyoke",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": { "node": ">=20" },
  "scripts": {
    "backend:up": "docker compose up -d --wait",
    "backend:down": "docker compose down -v",
    "provision": "node scripts/provision.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "playwright test",
    "reset": "docker compose down -v && docker compose up -d --wait && node scripts/provision.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
